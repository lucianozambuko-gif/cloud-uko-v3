# Copy this file to .env for local development. On Render, set these
# as Environment Variables on the service instead - never commit a
# real .env file (it's already in .gitignore).

# Supabase project settings (Project Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key - SECRET. Bypasses Row Level Security. Server only,
# never put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# PayFast merchant details (Settings > Integration in your PayFast dashboard)
# Sandbox test credentials (safe to use while PAYFAST_MODE=sandbox):
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
# Leave blank to match the sandbox test account above (it has no
# passphrase set). Set a real passphrase once you switch to live
# credentials, and make sure it matches the one set in your PayFast
# dashboard exactly.
PAYFAST_PASSPHRASE=
# "sandbox" while testing, "live" once you switch to your real
# merchant ID/key and are ready to take real payments.
PAYFAST_MODE=sandbox

# The static site's public base URL (no trailing slash)
SITE_URL=https://lucianozambuko-gif.github.io/cloud-uko-v3
# This backend's own public base URL once deployed on Render (no
# trailing slash) - PayFast's ITN webhook posts here.
SERVER_URL=https://your-render-service.onrender.com

# What "upgrade" costs, in ZAR, as a plain number with 2 decimals.
TRIAL_UPGRADE_AMOUNT=499.00

# CORS - should match SITE_URL. Separate multiple origins with a comma
# if you ever serve the site from more than one domain.
ALLOWED_ORIGIN=https://lucianozambuko-gif.github.io

PORT=3001
